// Dipakai saat website dipasang sendiri di Cloudflare (ditarik dari GitHub).
// Menyambungkan database D1 "sdn1palapa-content" sebagai binding bernama DB,
// supaya sambungan database tidak hilang setiap kali ada deploy baru.
{
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sdn1palapa-content",
      "database_id": "2c0a5bb3-d64c-4491-9f9f-d5c389aabbcd"
    }
  ]
}
